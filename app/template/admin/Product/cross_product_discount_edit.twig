{#
セット割引設定 - 編集画面
#}
{% extends '@admin/default_frame.twig' %}

{% set menus = ['product', 'cross_product_discount'] %}

{% block title %}セット割引設定 編集{% endblock %}
{% block sub_title %}{{ 'admin.product.product_management'|trans }}{% endblock %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <span class="card-title">セット割引ルール編集（ID: {{ rule.id }}）</span>
                    </div>
                    <div class="card-body">
                        <form method="post" action="{{ url('admin_cross_product_discount_edit', {'id': rule.id}) }}">
                            {{ form_widget(form._token) }}
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label class="col-form-label">{{ form.triggerProduct.vars.label }}</label>
                                </div>
                                <div class="col">
                                    {{ form_widget(form.triggerProduct, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.triggerProduct) }}
                                    <small class="form-text text-muted">この商品がカートに入っていると割引が発動します</small>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label class="col-form-label">{{ form.targetProduct.vars.label }}</label>
                                </div>
                                <div class="col">
                                    {{ form_widget(form.targetProduct, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.targetProduct) }}
                                    <small class="form-text text-muted">この商品に割引が適用されます</small>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label class="col-form-label">{{ form.discountType.vars.label }}</label>
                                </div>
                                <div class="col">
                                    {{ form_widget(form.discountType, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.discountType) }}
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label class="col-form-label">{{ form.discountValue.vars.label }}</label>
                                </div>
                                <div class="col">
                                    {{ form_widget(form.discountValue, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.discountValue) }}
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label class="col-form-label">{{ form.enabled.vars.label }}</label>
                                </div>
                                <div class="col">
                                    <div class="form-check">
                                        {{ form_widget(form.enabled, {'attr': {'class': 'form-check-input'}}) }}
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col text-end">
                                    <a class="btn btn-ec-sub me-2" href="{{ url('admin_cross_product_discount') }}">
                                        {{ 'admin.common.cancel'|trans }}
                                    </a>
                                    <button class="btn btn-ec-conversion" type="submit">
                                        {{ 'admin.common.save'|trans }}
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
