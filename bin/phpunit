#!/usr/bin/env php
<?php

// Use vendor/bin/phpunit directly (PHPUnit 11)
$phpunitBin = dirname(__DIR__).'/vendor/bin/phpunit';

if (!file_exists($phpunitBin)) {
    echo "Unable to find PHPUnit in vendor/bin/phpunit.\n";
    exit(1);
}

// Pass through all arguments
$args = array_slice($argv, 1);
$command = escapeshellcmd($phpunitBin) . ' ' . implode(' ', array_map('escapeshellarg', $args));

passthru($command, $exitCode);
exit($exitCode);
