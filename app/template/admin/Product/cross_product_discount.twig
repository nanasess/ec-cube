{#
セット割引設定 - 一覧・新規作成画面
商品Aがカートにある場合に商品Bに割引を適用するルールを管理する。
#}
{% extends '@admin/default_frame.twig' %}

{% set menus = ['product', 'cross_product_discount'] %}

{% block title %}セット割引設定{% endblock %}
{% block sub_title %}{{ 'admin.product.product_management'|trans }}{% endblock %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">

                {# 新規作成フォーム #}
                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <span class="card-title">新規セット割引ルール作成</span>
                    </div>
                    <div class="card-body">
                        <form method="post" action="{{ url('admin_cross_product_discount') }}">
                            {{ form_widget(form._token) }}
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label class="col-form-label">{{ form.triggerProduct.vars.label }}</label>
                                </div>
                                <div class="col">
                                    {{ form_widget(form.triggerProduct, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.triggerProduct) }}
                                    <small class="form-text text-muted">この商品がカートに入っていると割引が発動します</small>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label class="col-form-label">{{ form.targetProduct.vars.label }}</label>
                                </div>
                                <div class="col">
                                    {{ form_widget(form.targetProduct, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.targetProduct) }}
                                    <small class="form-text text-muted">この商品に割引が適用されます</small>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label class="col-form-label">{{ form.discountType.vars.label }}</label>
                                </div>
                                <div class="col">
                                    {{ form_widget(form.discountType, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.discountType) }}
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label class="col-form-label">{{ form.discountValue.vars.label }}</label>
                                </div>
                                <div class="col">
                                    {{ form_widget(form.discountValue, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.discountValue) }}
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label class="col-form-label">{{ form.enabled.vars.label }}</label>
                                </div>
                                <div class="col">
                                    <div class="form-check">
                                        {{ form_widget(form.enabled, {'attr': {'class': 'form-check-input'}}) }}
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col text-end">
                                    <button class="btn btn-ec-conversion" type="submit">新規作成</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                {# ルール一覧 #}
                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <span class="card-title">セット割引ルール一覧</span>
                    </div>
                    <div class="card-body p-0">
                        {% if rules|length > 0 %}
                            <table class="table table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th class="border-top-0 pt-2 pb-2 ps-3">ID</th>
                                        <th class="border-top-0 pt-2 pb-2">トリガー商品</th>
                                        <th class="border-top-0 pt-2 pb-2"></th>
                                        <th class="border-top-0 pt-2 pb-2">ターゲット商品</th>
                                        <th class="border-top-0 pt-2 pb-2">割引内容</th>
                                        <th class="border-top-0 pt-2 pb-2">状態</th>
                                        <th class="border-top-0 pt-2 pb-2"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for rule in rules %}
                                        <tr>
                                            <td class="align-middle ps-3">{{ rule.id }}</td>
                                            <td class="align-middle">{{ rule.triggerProduct.name }}</td>
                                            <td class="align-middle text-center"><i class="fa fa-arrow-right"></i></td>
                                            <td class="align-middle">{{ rule.targetProduct.name }}</td>
                                            <td class="align-middle">
                                                <span class="badge bg-info">{{ rule.discountDescription }}</span>
                                            </td>
                                            <td class="align-middle">
                                                {% if rule.enabled %}
                                                    <span class="badge bg-success">有効</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">無効</span>
                                                {% endif %}
                                            </td>
                                            <td class="align-middle text-end pe-3">
                                                <a class="btn btn-ec-actionIcon me-1"
                                                   href="{{ url('admin_cross_product_discount_edit', {'id': rule.id}) }}"
                                                   data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'admin.common.edit'|trans }}">
                                                    <i class="fa fa-pencil fa-lg text-secondary"></i>
                                                </a>
                                                <div class="d-inline-block" data-bs-toggle="tooltip"
                                                     data-bs-placement="top" title="{{ 'admin.common.delete'|trans }}">
                                                    <a class="btn btn-ec-actionIcon" data-bs-toggle="modal"
                                                       data-bs-target="#DeleteModal"
                                                       data-url="{{ url('admin_cross_product_discount_delete', {'id': rule.id}) }}"
                                                       data-message="「{{ rule.triggerProduct.name }} → {{ rule.targetProduct.name }} {{ rule.discountDescription }}」を削除してよろしいですか？">
                                                        <i class="fa fa-close fa-lg text-secondary"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <div class="card-body">
                                <p class="text-muted mb-0">セット割引ルールはまだ登録されていません。</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# 削除モーダル #}
                <div class="modal fade" id="DeleteModal" tabindex="-1" role="dialog"
                     aria-labelledby="DeleteModal" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title fw-bold">
                                    {{ 'admin.common.delete_modal__title'|trans }}
                                </h5>
                                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                                <p class="text-start modal-message"></p>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-ec-sub" type="button" data-bs-dismiss="modal">
                                    {{ 'admin.common.cancel'|trans }}
                                </button>
                                <a class="btn btn-ec-delete" href="#" {{ csrf_token_for_anchor() }}
                                   data-method="delete" data-confirm="false">
                                    {{ 'admin.common.delete'|trans }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascript %}
    <script>
        $(function() {
            // 削除モーダルのhrefとmessageの変更
            $('#DeleteModal').on('shown.bs.modal', function(event) {
                var target = $(event.relatedTarget);
                $(this).find('[data-method="delete"]').attr('href', target.data('url'));
                $(this).find('p.modal-message').text(target.data('message'));
            });
        });
    </script>
{% endblock %}
